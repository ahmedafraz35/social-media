<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark mb-4">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="#">SocialBook</a>
    <div class="d-flex w-100 align-items-center justify-content-between">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center" [routerLink]="['/chat']"><i class="bi bi-chat-dots me-1"></i>Chat</a>
        </li>
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center" [routerLink]="['/profile']"><i class="bi bi-person me-1"></i>Profile</a>
        </li>
        <li class="nav-item">
          <a class="nav-link d-flex align-items-center" href="#"><i class="bi bi-gear me-1"></i>Settings</a>
        </li>
      </ul>
      <form class="d-flex mx-auto searchbar-professional" style="width: 400px; max-width: 100%;">
        <div class="input-group shadow rounded-pill overflow-hidden">
          <input class="form-control border-0 px-4 py-2" type="search" placeholder="Search..." aria-label="Search" style="background: #ffffff; color: #fff;">
          <button class="btn btn-outline-light px-4" type="submit" style="background: #333; border: none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99c.41.41 1.09.41 1.5 0s.41-1.09 0-1.5l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#fff"/>
            </svg>
          </button>
        </div>
      </form>
      <div class="d-flex align-items-center ms-3">
        <!-- User Profile Dropdown -->
        <div class="dropdown" style="position: relative;">
          <button class="btn p-0 border-0 bg-transparent d-flex align-items-center" (click)="toggleDropdown()">
            <img [src]="profileImage" alt="Profile" width="40" height="40"
              class="rounded-circle border border-2 border-white shadow-sm">
          </button>
          <ul *ngIf="dropdownOpen" class="dropdown-menu dropdown-menu-end show shadow"
            style="display: block; position: absolute; right: 0; top: 48px;">
            <li><a class="dropdown-item d-flex align-items-center" (click)="logout(); toggleDropdown()"><i
                  class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
            <li><a class="dropdown-item d-flex align-items-center" [routerLink]="['/chat']" (click)="toggleDropdown()"><i
                  class="bi bi-chat-dots me-2"></i>Chat</a></li>
            <li><a class="dropdown-item d-flex align-items-center" [routerLink]="['/profile']" (click)="toggleDropdown()"><i
                  class="bi bi-person me-2"></i>Profile</a></li>
            <li><a class="dropdown-item d-flex align-items-center" href="#" (click)="toggleDropdown()"><i
                  class="bi bi-gear me-2"></i>Settings</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Main Layout -->
<div class="container-fluid">
  <div class="row">
    <!-- Left Sidebar -->
    <div class="col-lg-2 d-none d-lg-block">
      <div class="sidebar-left h-100 p-3">
        <h5 class="side-heading mb-4">Menu</h5>
        <ul class="nav flex-column left-links-list">
          <li class="nav-item mb-2">
            <a class="nav-link left-side-links d-flex justify-content-between align-items-center px-3 py-2 rounded shadow-sm" href="#">
              <span class="fw-semibold">Friends</span>
              <i class="bi bi-people ms-2"></i>
            </a>
          </li>
          <li class="nav-item mb-2">
            <a class="nav-link left-side-links d-flex justify-content-between align-items-center px-3 py-2 rounded shadow-sm" routerLink="/chat">
              <span class="fw-semibold">Chat</span>
              <i class="bi bi-chat-dots ms-2"></i>
            </a>
          </li>
          <li class="nav-item mb-2">
            <a class="nav-link left-side-links d-flex justify-content-between align-items-center px-3 py-2 rounded shadow-sm" href="#">
              <span class="fw-semibold">Settings</span>
              <i class="bi bi-gear ms-2"></i>
            </a>
          </li>
          <li class="nav-item mb-2">
            <a class="nav-link left-side-links d-flex justify-content-between align-items-center px-3 py-2 rounded shadow-sm" routerLink="/profile">
              <span class="fw-semibold">Profile</span>
              <i class="bi bi-person ms-2"></i>
            </a>
          </li>
          <li class="nav-item mb-2">
            <a class="nav-link left-side-links d-flex justify-content-between align-items-center px-3 py-2 rounded shadow-sm" href="#">
              <span class="fw-semibold">Notifications</span>
              <i class="bi bi-bell ms-2"></i>
            </a>
          </li>
          <li class="nav-item mb-2">
            <a class="nav-link left-side-links d-flex justify-content-between align-items-center px-3 py-2 rounded shadow-sm" href="#">
              <span class="fw-semibold">Events</span>
              <i class="bi bi-calendar-event ms-2"></i>
            </a>
          </li>
        </ul>
        <br>
        <!-- Ad Section -->
        <div>
          <h5 class="side-heading mb-4 sponsored-heading">Sponsored</h5>
          <div class="ad-section mt-4 p-2 rounded shadow-sm">
            <!-- <h6 class="ad-title mb-3 fw-bold text-primary text-center">Sponsored</h6> -->
            <div class="ad-list d-flex flex-column gap-3">
              <div class="ad-card p-2 rounded bg-white shadow-sm text-center">
                <a href="#" class="d-block mb-2">
                  <img src="/nikhil-eEumkKjg7Jo-unsplash.jpg" alt="Ad1" class="img-fluid ad-img rounded w-100"
                    style="width: 100%; height: 120px; object-fit: cover;">
                </a>
                <div class="ad-caption text-muted small">Get 50% off on your first order! <span
                    class="text-success fw-semibold">Shop Now</span></div>
              </div>
              <div class="ad-card p-2 rounded bg-white shadow-sm text-center">
                <a href="#" class="d-block mb-2">
                  <img src="/amirali-mirhashemian-jh5XyK4Rr3Y-unsplash.jpg" alt="Ad2"
                    class="img-fluid ad-img rounded w-100" style="width: 100%; height: 120px; object-fit: cover;">
                </a>
                <div class="ad-caption text-muted small">Upgrade your running gear! <span
                    class="text-primary fw-semibold">Shop Sports</span></div>
              </div>
              <div class="ad-card p-2 rounded bg-white shadow-sm text-center">
                <a href="#" class="d-block mb-2">
                  <img
                    src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=400&q=80"
                    alt="Ad3" class="img-fluid ad-img rounded w-100"
                    style="width: 100%; height: 120px; object-fit: cover;">
                </a>
                <div class="ad-caption text-muted small">Delicious cakes delivered! <span
                    class="text-danger fw-semibold">Order Now</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Feed -->
    <div class="col-lg-8 col-md-10 mx-auto mb-4">
      <!-- Create Post Section -->
      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Create a Post</h5>
          <div class="mb-3">
            <textarea [(ngModel)]="newPostText" class="form-control" placeholder="What's on your mind?" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <input type="file" (change)="onPostImageChange($event)" accept="image/*" class="form-control">
          </div>
          <button class="btn btn-primary" (click)="uploadPost()">Post</button>
        </div>
      </div>
      
      <div class="row g-4">
        <div class="col-md-6" *ngFor="let post of posts">
          <div class="card post-card shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between" style="min-height: 520px; height: auto;">
              <div>
                <div class="d-flex align-items-center mb-3">
                  <img [src]="post.user?.profileImageUrl || 'https://randomuser.me/api/portraits/men/32.jpg'" class="rounded-circle me-2" width="48" height="48" alt="User">
                  <div>
                    <h6 class="mb-0 fw-bold">{{ post.user?.username }}</h6>
                    <small class="text-muted">{{ post.createdAt ? (post.createdAt | date:'short') : '' }}</small>
                  </div>
                </div>
                <p class="card-text fs-6 mb-3">{{ post.caption }}</p>
                <div class="post-image-container mb-3" *ngIf="post.imageUrl">
                  <img [src]="post.imageUrl" class="img-fluid rounded w-100" style="height: 320px; object-fit: cover;" alt="Post image">
                </div>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-auto">
                <button class="btn btn-post-action" (click)="likePost(post)"><i class="bi bi-hand-thumbs-up me-2"></i>Like <span class="badge bg-primary ms-1">{{ post.likesCount }}</span></button>
                <button class="btn btn-post-action" (click)="toggleCommentBox(post)"><i class="bi bi-chat me-2"></i>Comment</button>
                <button class="btn btn-post-action"><i class="bi bi-share me-2"></i>Share</button>
              </div>
              <!-- Comment Box -->
              <div *ngIf="post.showCommentBox" class="mt-3">
                <div class="mb-2 d-flex gap-2">
                  <input [(ngModel)]="commentTexts[post.id]" class="form-control" placeholder="Add a comment...">
                  <button class="btn btn-primary btn-sm" (click)="uploadComment(post)">Upload Comment</button>
                </div>
                <div class="mt-3">
                  <div *ngFor="let comment of post.comments; let i = index" class="mb-2">
                    <div class="bg-light rounded px-3 py-2">
                      <strong>{{ comment.user?.username }}:</strong> {{ comment.text }}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Right Sidebar -->
    <div class="col-lg-2 d-none d-lg-block">
      <div class="sidebar-right h-100 p-3">
        <h5 class="side-heading mb-4">Friends</h5>
        <ul class="nav flex-column right-links-list">
          <li class="nav-item mb-2">
            <div class="right-card d-flex align-items-center px-3 py-2 rounded shadow-sm">
              <img src="https://randomuser.me/api/portraits/men/45.jpg" class="rounded-circle me-2" width="32"
                height="32" alt="Friend">
              <span class="fw-semibold">Alex Brown</span>
              <span class="badge bg-success ms-auto">Online</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <div class="right-card d-flex align-items-center px-3 py-2 rounded shadow-sm">
              <img src="https://randomuser.me/api/portraits/women/46.jpg" class="rounded-circle me-2" width="32"
                height="32" alt="Friend">
              <span class="fw-semibold">Lisa White</span>
              <span class="badge bg-success ms-auto">Online</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <div class="right-card d-flex align-items-center px-3 py-2 rounded shadow-sm">
              <img src="https://randomuser.me/api/portraits/men/47.jpg" class="rounded-circle me-2" width="32"
                height="32" alt="Suggested">
              <span class="fw-semibold">Michael Green</span>
              <span class="badge bg-primary ms-auto">Suggested</span>
            </div>
          </li>
          <li class="nav-item mb-2">
            <div class="right-card d-flex align-items-center px-3 py-2 rounded shadow-sm">
              <img src="https://randomuser.me/api/portraits/women/48.jpg" class="rounded-circle me-2" width="32"
                height="32" alt="Suggested">
              <span class="fw-semibold">Emily Clark</span>
              <span class="badge bg-primary ms-auto">Suggested</span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
<!-- Footer -->
<footer class="footer mt-auto py-4" style="background: #111; color: #fff; border-top: 1px solid #222;">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-4 text-center text-md-start mb-2 mb-md-0">
        <span class="fw-bold" style="letter-spacing: 2px; font-size: 1.2rem;">SocialBook</span>
      </div>
      <div class="col-md-4 text-center mb-2 mb-md-0">
        <a href="#" class="text-light mx-2 text-decoration-none footer-link">Home</a>
        <a href="#" class="text-light mx-2 text-decoration-none footer-link">About</a>
        <a href="#" class="text-light mx-2 text-decoration-none footer-link">Contact</a>
        <a href="#" class="text-light mx-2 text-decoration-none footer-link">Privacy</a>
      </div>
      <div class="col-md-4 text-center text-md-end">
        <span class="small text-muted">&copy; 2025 SocialBook. All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>